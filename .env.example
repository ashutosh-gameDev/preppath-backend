# ---------------------------------------------------------------------------
# Backend environment variables (FastAPI)
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Postgres connection string (Supabase Postgres in production, local Postgres
# in dev). SQLAlchemy + psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/examprep

# --- Supabase -----------------------------------------------------------------
# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe for frontend use)
SUPABASE_ANON_KEY=your-anon-key
# Service role key - server-side ONLY. Grants full DB/storage access.
# Used by the backend to call Supabase Admin APIs (e.g. list users) and to
# manage Storage buckets. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase JWT secret (Settings -> API -> JWT Secret) used to verify
# access tokens issued to the frontend when JWKS verification is not used.
SUPABASE_JWT_SECRET=your-jwt-secret
# Storage bucket used for question images / PDFs / bulk import files.
SUPABASE_STORAGE_BUCKET=exam-platform-media

# --- App ----------------------------------------------------------------------
ENVIRONMENT=development
API_V1_PREFIX=/api
# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# This backend's own reachable base URL - only used to build URLs for the
# local dev-mode question-image upload fallback (see
# app/services/storage_service.py). Irrelevant once SUPABASE_STORAGE_BUCKET
# uploads are live (Supabase Storage URLs are already absolute).
PUBLIC_BASE_URL=http://localhost:8000
# Secret used only for internally-signed tokens (e.g. seed/admin bootstrap). Not
# used for verifying Supabase-issued tokens.
APP_SECRET_KEY=change-me-in-production

# --- Bootstrap admin (used by scripts/create_admin.py) -----------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Razorpay (premium subscriptions) -----------------------------------------
# Free test-mode keys: Razorpay Dashboard -> Settings -> API Keys (no business
# verification needed to get test keys and test the full checkout flow).
# Leave blank in local dev to use the dev-only mock checkout instead - see
# app/api/v1/endpoints/premium.py.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. Optional locally (payment confirmation
# still works via the client-side /premium/verify call without it).
RAZORPAY_WEBHOOK_SECRET=
